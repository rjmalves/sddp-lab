{
    "seed": 42,
    "initial_season": 1,
    "branchings": 10,
    "graph": {
        "params": {
            "file": "graph.jsonc"
        }
    },
    "inflow": {
        "stochastic_process": {
            // AR | PAR | HMM | ...
            "kind": "Naive",
            "params": {
                "file": "inflow_scenarios.jsonc"
            }
        }
    },
    "load": {
        // DeterministicLoad | ...
        "kind": "DeterministicLoad",
        "params": {
            "file": "load.csv"
        }
    },
    // Per-stage block definitions using stage_blocks.
    // Block durations must sum to each stage's duration (from graph.jsonc datetimes):
    //   Stage 1: Jan 2024 = 744 h  (31 days)
    //   Stage 2: Feb 2024 = 696 h  (29 days -- 2024 is a leap year)
    //   Stage 3: Mar 2024 = 744 h  (31 days)
    //   Stage 4: Apr 2024 = 720 h  (30 days)
    "stage_blocks": {
        // Stage 1: 3 parallel blocks (744 h total)
        "1": {
            "mode": "parallel",
            "definitions": [
                { "name": "peak",    "duration_hours": 248.0 },
                { "name": "shoulder","duration_hours": 248.0 },
                { "name": "offpeak", "duration_hours": 248.0 }
            ]
        },
        // Stage 2: 2 parallel blocks (696 h total)
        "2": {
            "mode": "parallel",
            "definitions": [
                { "name": "day",   "duration_hours": 348.0 },
                { "name": "night", "duration_hours": 348.0 }
            ]
        },
        // Stage 3: 2 chronological blocks (744 h total)
        "3": {
            "mode": "chronological",
            "definitions": [
                { "name": "first",  "duration_hours": 372.0 },
                { "name": "second", "duration_hours": 372.0 }
            ]
        },
        // Stage 4: 3 chronological blocks (720 h total)
        "4": {
            "mode": "chronological",
            "definitions": [
                { "name": "morning",   "duration_hours": 240.0 },
                { "name": "afternoon", "duration_hours": 240.0 },
                { "name": "evening",   "duration_hours": 240.0 }
            ]
        }
    }
}
