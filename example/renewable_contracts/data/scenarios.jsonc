{
    "seed": 42,
    "initial_season": 1,
    "branchings": 5,
    "graph": {
        "params": {
            "file": "graph.jsonc"
        }
    },
    "inflow": {
        "stochastic_process": {
            "kind": "Naive",
            "params": {
                "file": "inflow_scenarios.jsonc"
            }
        }
    },
    "load": {
        "kind": "DeterministicLoad",
        "params": {
            "file": "load.csv"
        }
    }
}
