    //   Stage 11 (Nov 2024): 720 h  -- peak=120 h, shoulder=240 h, offpeak=360 h
    //   Stage 12 (Dec 2024): 744 h  -- peak=124 h, shoulder=248 h, offpeak=372 h
    "stage_blocks": {
        "1":  { "mode": "parallel", "definitions": [ { "name": "peak", "duration_hours": 124.0 }, { "name": "shoulder", "duration_hours": 248.0 }, { "name": "offpeak", "duration_hours": 372.0 } ] },
        "2":  { "mode": "parallel", "definitions": [ { "name": "peak", "duration_hours": 116.0 }, { "name": "shoulder", "duration_hours": 232.0 }, { "name": "offpeak", "duration_hours": 348.0 } ] },
