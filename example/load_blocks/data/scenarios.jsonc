{
    "seed": 42,
    "initial_season": 1,
    "branchings": 5,
    "graph": {
        "params": {
            "file": "graph.jsonc"
        }
    },
    "inflow": {
        "stochastic_process": {
            "kind": "Naive",
            "params": {
                "file": "inflow_scenarios.jsonc"
            }
        }
    },
    "load": {
        "kind": "DeterministicLoad",
        "params": {
            "file": "load.csv"
        }
    },
    // Per-stage parallel blocks with peak:shoulder:offpeak = 1:2:3 proportions.
    // Block durations must sum to the stage duration derived from graph datetimes:
    //   Stage  1 (Jan 2024): 744 h  -- peak=124 h, shoulder=248 h, offpeak=372 h
    //   Stage  2 (Feb 2024): 696 h  -- peak=116 h, shoulder=232 h, offpeak=348 h
    //   Stage  3 (Mar 2024): 744 h  -- peak=124 h, shoulder=248 h, offpeak=372 h
