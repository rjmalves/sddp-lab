{
    "seed": 41,
    "initial_season": 1,
    "branchings": 10,
    "graph": {
        "params": {
            "file": "graph.jsonc"
        }
    },
    "inflow": {
        "stochastic_process": {
            // AR | PAR | HMM | ...
            "kind": "AutoRegressive",
            "params": {
                "file": "inflow_scenarios.jsonc"
            }
        }
    },
    "load": {
        // DeterministicLoad | ...
        "kind": "DeterministicLoad",
        "params": {
            "file": "load.csv"
        }
    }
}
