{
    "inputs": {
        "path": "data",
        // Each file defines settings for a specific
        // component of the lab
        "files": {
            // Defines the scenarios that are used to the
            // optimization, including the scenario generation
            // model and its parameters
            "scenarios": "scenarios.jsonc",
            // Defines the system that is being optimized,
            // with all the hydro plants, thermal plants, 
            // load buses and exchange lines.
            "system": "system.jsonc",
            // Defines the constraints that are used in some
            // problems, in a generic way
            "constraints": "constraints.jsonc"
        }
    },
    "engine": {
        "kind": "SDDPEngine",
        "params": {
            "policy": {
                "convergence": {
                    // Min/Max number of iterations
                    "min_iterations": 10,
                    "max_iterations": 128,
                    // Early stopping criteria and params
                    "stopping_criteria": {
                        // IterationLimit | TimeLimit | LowerBoundStability | Statistical | ...
                        "kind": "IterationLimit",
                        "params": {
                            "num_iterations": 128
                        }
                    }
                },
                "risk_measure": {
                    // Expectation | WorstCase | AVaR | CVaR | ...
                    "kind": "CVaR",
                    // each risk measure might need different params,
                    // such as the confidence level for AVaR, etc.
                    "params": {
                        "alpha": 0.2,
                        "lambda": 0.9
                    }
                },
                "parallel_scheme": {
                    "kind": "Serial",
                    "params": {}
                }
            },
            "simulation": {
                "num_simulated_series": 100,
                "parallel_scheme": {
                    "kind": "Serial",
                    "params": {}
                }
            },
            "solver": {
                "name": "GLPK",
                "attributes": {}
            }
        }
    }
}