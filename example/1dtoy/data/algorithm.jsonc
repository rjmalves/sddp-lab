{
    "engine": "sddp",
    "policy": {
        "convergence": {
            // Min/Max number of iterations
            "min_iterations": 10,
            "max_iterations": 128,
            // Early stopping criteria and params
            "stopping_criteria": {
                // IterationLimit | TimeLimit | LowerBoundStability | Statistical | ...
                "kind": "IterationLimit",
                "params": {
                    "num_iterations": 128
                }
            }
        },
        "risk_measure": {
            // Expectation | WorstCase | AVaR | CVaR | ...
            "kind": "CVaR",
            // each risk measure might need different params,
            // such as the confidence level for AVaR, etc.
            "params": {
                "alpha": 0.2,
                "lambda": 0.9
            }
        },
        "parallel_scheme": {
            "kind": "Serial",
            "params": {}
        },
        "results": {
            "path": "out/policy",
            "save": true,
            "format": {
                "kind": "ParquetFormat",
                "params": {}
            }
        }
    },
    "simulation": {
        "num_simulated_series": 100,
        "policy": {
            "load": false,
            "path": "out/policy",
            "format": {
                "kind": "ParquetFormat",
                "params": {}
            }
        },
        "parallel_scheme": {
            "kind": "Serial",
            "params": {}
        },
        "results": {
            "path": "out/simulation",
            "save": true,
            "format": {
                "kind": "ParquetFormat",
                "params": {}
            }
        }
    }
    // TODO - stages with different lengths demand
    // unit conversions when constructing each subproblem
    // TODO - policy graph x stochastic processes
    // some other fields may influence the policy graph
    // like scenarios, load, costs, etc.
}